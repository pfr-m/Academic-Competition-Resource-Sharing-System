}

function formatChineseDateTime(date: Date) {
  if (Number.isNaN(date.getTime())) {
    return '閺冨爼妫垮鍛暰'
  }
  return date.toLocaleString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  }).replaceAll('/', '-')
}

function mapTeam(item: any): TeamView {
