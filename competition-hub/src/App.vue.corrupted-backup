async function toggleBlogAction(type: 'LIKE' | 'COLLECT') {
  if (!activeBlog.value) return
  const pendingKey = type === 'LIKE' ? 'like' : 'collect'
  if (socialPending[pendingKey]) return
  socialPending[pendingKey] = true
  try {
    const data = await api<any>(`/blogs/${activeBlog.value.id}/actions`, {
      method: 'POST',
      body: JSON.stringify({ type }),
    })
    activeBlog.value.social = mapSocial(data.stats)
    await Promise.all([loadBlogs(), loadCreatorStats()])
  } catch (error) {
    ElMessage.error(error instanceof Error ? error.message : '娴滄帒濮╂径杈Е')
  } finally {
    socialPending[pendingKey] = false
  }
}

async function toggleFollowAuthor() {
  if (!activeBlog.value || activeBlog.value.authorId === currentUser.value.id || socialPending.follow) return
  socialPending.follow = true
  try {
    const data = await api<any>(`/blogs/${activeBlog.value.id}/follow-author`, { method: 'POST' })
    activeBlog.value.social.followed = Boolean(data.active)
    await loadCreatorStats()
  } catch (error) {
    ElMessage.error(error instanceof Error ? error.message : '鍏虫敞婢惰精瑙?)
  } finally {
    socialPending.follow = false
  }
}

function mapSocial(source: any): BlogSocialView {
  return {
    likes: source?.likes || 0,
    collects: source?.collects || 0,
    liked: Boolean(source?.liked),
    collected: Boolean(source?.collected),
    followed: Boolean(source?.followed),
  }
}

