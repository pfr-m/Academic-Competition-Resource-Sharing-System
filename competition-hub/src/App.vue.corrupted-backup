function mapSalon(item: any): SalonView {
  const date = new Date(item.startsAt)
  const month = Number.isNaN(date.getTime()) ? '閺冦儲婀? : `${date.getMonth() + 1}閺堝潉
  const day = Number.isNaN(date.getTime()) ? '--' : String(date.getDate()).padStart(2, '0')
  return {
