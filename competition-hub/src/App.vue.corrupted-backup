const viewByRoute = Object.fromEntries(Object.entries(routeByView).map(([view, path]) => [path, view]))

function viewFromLocation(pathname = window.location.pathname) {
  return viewByRoute[pathname] || 'dashboard'
}

function syncViewFromLocation() {
  activeView.value = viewFromLocation()
}

function navigateTo(view: string) {
  const targetView = routeByView[view] ? view : 'dashboard'
  activeView.value = targetView
  const nextPath = routeByView[targetView]
  if (window.location.pathname !== nextPath) {
    window.history.pushState({ view: targetView }, '', nextPath)
  }
}

function queryString(params: Record<string, string | number | undefined>) {
  const search = new URLSearchParams()
  Object.entries(params).forEach(([key, value]) => {
    if (value !== undefined && value !== '') {
      search.set(key, String(value))
    }
  })
  return search.toString()
}

async function loadResources() {
  const query = queryString({
    page: resourcePage.current,
    size: resourcePage.size,
    keyword: resourceKeyword.value.trim(),
    contest: resourceContest.value,
    type: resourceType.value,
  })
  const data = await api<any>(`/resources?${query}`)
  const records = Array.isArray(data) ? data : data.records
  resourcePage.total = Array.isArray(data) ? records.length : data.total
  resourcePage.current = Array.isArray(data) ? resourcePage.current : data.current
  resourcePage.size = Array.isArray(data) ? resourcePage.size : data.size
  selectedResourceIds.value = []
  resources.splice(0, resources.length, ...records.map((item: any) => ({
    id: item.id,
    uploaderId: item.uploaderId,
    contest: item.contest,
    type: item.type,
    title: item.title,
    summary: item.summary,
    downloads: item.downloadCount,
    uploader: item.uploader,
  })))
}

