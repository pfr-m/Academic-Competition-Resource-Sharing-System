async function resolveLoginError(response: Response) {
  const fallback = response.status === 401 || response.status === 403
    ? '鐧诲綍婢惰精瑙﹂敍姘冲閸欓攱鍨ㄥ瘑鐮侀柨娆掝嚖閿涘矁顕柌宥嗘煀鏉堟挸鍙?
    : '鐧诲綍婢惰精瑙﹂敍姘箛閸斺剝娈忛弮鏈电瑝閸欘垳鏁ら敍宀冾嚞缁嬪秴鎮楅崘宥堢槸'
  const raw = await response.text()
  if (!raw) return fallback
  try {
    const parsed = JSON.parse(raw)
    const message = parsed.message || parsed.error || parsed.detail
    if (typeof message === 'string' && message.trim()) {
      if (/閻劍鍩涢崥宄惧瘑鐮亅Bad credentials|Unauthorized|Forbidden/i.test(message)) {
        return '鐧诲綍婢惰精瑙﹂敍姘冲閸欓攱鍨ㄥ瘑鐮侀柨娆掝嚖閿涘矁顕柌宥嗘煀鏉堟挸鍙?
      }
      if (/lock|locked|缁備胶鏁闁夸礁鐣?i.test(message)) {
        return '璐﹀彿瀹歌尪顫﹂柨浣哥暰閿涘矁顕懕鏃傞兇绠＄悊閸?
      }
      return `鐧诲綍婢惰精瑙﹂敍?{message}`
    }
  } catch {
    if (/閻劍鍩涢崥宄惧瘑鐮亅Unauthorized|Forbidden|401|403/i.test(raw)) {
      return '鐧诲綍婢惰精瑙﹂敍姘冲閸欓攱鍨ㄥ瘑鐮侀柨娆掝嚖閿涘矁顕柌宥嗘煀鏉堟挸鍙?
    }
  }
  return fallback
}

