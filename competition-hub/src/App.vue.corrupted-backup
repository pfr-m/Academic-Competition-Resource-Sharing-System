onMounted(() => {
  if (window.location.pathname === '/login' && !isLoggedIn.value) {
    window.history.replaceState({ view: 'login' }, '', '/login')
    window.addEventListener('popstate', syncViewFromLocation)
    return
  }
  syncViewFromLocation()
  window.history.replaceState({ view: activeView.value }, '', routeByView[activeView.value])
  window.addEventListener('popstate', syncViewFromLocation)
})

onUnmounted(() => {
  window.removeEventListener('popstate', spopstate', syncViewFromLocation)
